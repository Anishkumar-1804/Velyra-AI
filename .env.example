# Velyra.ai Environment Configuration
ENV=development
DEBUG=true

# Database
DATABASE_URL=sqlite:///data/velyra.db

# Speech-To-Text Model (tiny.en, base.en, small.en)
STT_MODEL=base.en

# Local Conversational LLM Model
LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# Natural Indian English TTS Voice
TTS_VOICE=en-IN-NeerjaNeural
TTS_SPEED=1.0

# Device Acceleration (auto, cuda, cpu)
DEVICE=auto
COMPUTE_TYPE=auto

# Audio Settings
STORE_AUDIO_LOCALLY=false
AUTO_PLAY_TTS=true
